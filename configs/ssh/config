Include devbox.conf/*.conf
Include service_port_forward_config

# GitHub: personal repos (incl. these dotfiles) use the personal key.
Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519_personal

# Bitbucket: Atlassian work.
Host bitbucket.org
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519_atlassian

# Default: Atlassian key for everything else.
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519_atlassian

Include dns_host_config
Include dev_env_config
