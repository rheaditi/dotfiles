# Aditi's non-secret dotfiles profile.
#
# Forks should copy this file to configs/<username>.env, update the values,
# remove configs/rheaditi.env, and commit their replacement profile.

# Git identity configuration included for personal checkout directories.
DOTFILES_USER_GITCONFIG="$DOTFILES_ROOT/configs/git/rheaditi.gitconfig"

# Optional work-specific Git configuration.
DOTFILES_PRIVATE_GITCONFIG="$HOME/dev/dotfiles-private/atlassian/git/amohanty.local.gitconfig"
