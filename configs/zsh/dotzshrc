# Step 0: Pre-requisite Variables

DOTFILES_CONFIG_FILE="${(%):-%x}" # Get the directory where this config file is actually located (resolve symlinks)
if [[ -L "$DOTFILES_CONFIG_FILE" ]]; then
  DOTFILES_CONFIG_FILE="$(readlink "$DOTFILES_CONFIG_FILE")"
fi
DOTFILES_CONFIG_DIR="$(cd "$(dirname "$DOTFILES_CONFIG_FILE")" && pwd)"
DOTFILES_ROOT="$(cd "$DOTFILES_CONFIG_DIR/../.." && pwd)"

# Source platform detection utilities
source "$DOTFILES_ROOT/common/utils/platform-detection.sh"

# Step 1: Setup paths
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

# Step 2: Source oh-my-zsh options & prompt options
# oh-my-zsh overrides the prompt so Pure must be activated after source $ZSH/oh-my-zsh.sh.
source "$DOTFILES_CONFIG_DIR/zshrc.ohmyzsh.sh"
source "$DOTFILES_CONFIG_DIR/zshrc.prompt.sh"

# Step 3: User configurations
export LANG=en_US.UTF-8
export EDITOR=vim

# Step 4: Source platform-specific configuration
source "$DOTFILES_CONFIG_DIR/zshrc.platform.sh"
if is-macos; then
  source "$DOTFILES_CONFIG_DIR/zshrc.macos.sh"
elif is-linux; then
  source "$DOTFILES_CONFIG_DIR/zshrc.linux.sh"
fi

# Step 5: Source other configurations
source "$DOTFILES_CONFIG_DIR/zshrc.alias.sh"
source "$DOTFILES_CONFIG_DIR/zshrc.functions.sh"

# Step 6: Source private configurations (if they exist)
source "$DOTFILES_CONFIG_DIR/zshrc.private.sh"
if [ -f "$HOME/.afm-bin-path-manager.zsh" ]; then source "$HOME/.afm-bin-path-manager.zsh"; fi

# --- Secrets from macOS keychain --------------------------------------------
# Reads keychain secrets into env vars. Missing items are collected and reported
# in a single warning at most once per day, so it's a visible reminder to add
# them (with the exact command) rather than cryptic startup spam. Silent on
# non-macOS, where `security` / the login keychain don't apply.
if is-macos; then
  typeset -ga _KEYCHAIN_MISSING=()

  # Read a keychain item once and export it to one or more env vars.
  # Usage: keychain_export keychain_item_name VAR_NAME [VAR_NAME ...]
  keychain_export() {
    local item="$1" val; shift
    if val=$(security find-generic-password -a "$USER" -s "$item" -w 2>/dev/null); then
      local var_name
      for var_name in "$@"; do export "$var_name=$val"; done
    else
      _KEYCHAIN_MISSING+="$item"
    fi
  }

  # signalfx (read once, used by terraform + ops-sherpa)
  keychain_export signalfx_auth_token        TF_VAR_signalfx_auth_token SIGNALFX_API_TOKEN
  # ops-sherpa
  keychain_export ops_sherpa_atlassian_token ATLASSIAN_API_TOKEN
  keychain_export bitbucket_token            BITBUCKET_TOKEN
  keychain_export opsj_token                 OPS_JIRA_TOKEN

  # Single combined warning, throttled to once per 24h.
  if (( ${#_KEYCHAIN_MISSING} )); then
    _kc_stamp="${TMPDIR:-/tmp}/.keychain_warn"
    if [[ -z $(find "$_kc_stamp" -mtime -1 2>/dev/null) ]]; then
      # De-duplicate item names (signalfx is read twice).
      typeset -gaU _kc_unique=("${_KEYCHAIN_MISSING[@]}")
      print -u2 "⚠️  Missing keychain item(s): ${(j:, :)_kc_unique}"
      print -u2 "    Add each with: security add-generic-password -a \"\$USER\" -s \"<item>\" -w"
      touch "$_kc_stamp"
    fi
    unset _kc_stamp _kc_unique
  fi
  unset _KEYCHAIN_MISSING
fi