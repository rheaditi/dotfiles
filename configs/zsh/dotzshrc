export ZSH=$HOME/.oh-my-zsh

# Get the directory where this config file is actually located (resolve symlinks)
DOTFILES_CONFIG_FILE="${(%):-%x}"
# Resolve symlink to get the real path
if [[ -L "$DOTFILES_CONFIG_FILE" ]]; then
  DOTFILES_CONFIG_FILE="$(readlink "$DOTFILES_CONFIG_FILE")"
fi
DOTFILES_CONFIG_DIR="$(cd "$(dirname "$DOTFILES_CONFIG_FILE")" && pwd)"
DOTFILES_ROOT="$(cd "$DOTFILES_CONFIG_DIR/../.." && pwd)"

# Source platform detection utilities
source "$DOTFILES_ROOT/common/utils/platform-detection.sh"

# zsh configuration
COMPLETION_WAITING_DOTS="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"
ZSH_THEME=""

# Set directory variables based on environment
if is-devbox; then
  DIR_DEV="$HOME/dev"
  DIR_DOTFILES="$DIR_DEV/dotfiles"
  DIR_DOTFILES_PRIVATE="$HOME/dotfiles"
else
  DIR_DEV="$HOME/dev"
  DIR_DOTFILES="$DIR_DEV/dotfiles"
  DIR_DOTFILES_PRIVATE="$DIR_DEV/dotfiles-private"
fi

# User configuration
export LANG=en_US.UTF-8
export EDITOR=vim

# Add user local bin to PATH (for starship and other user-installed tools)
export PATH="$HOME/local/bin:$PATH"

# Load Oh My Zsh and plugins
plugins=(git zsh-syntax-highlighting z)
source $ZSH/oh-my-zsh.sh

# Source platform-specific configuration if it exists
if is-macos && [[ -f "${DOTFILES_CONFIG_DIR}/zshrc.macos.sh" ]]; then
  source "${DOTFILES_CONFIG_DIR}/zshrc.macos.sh"
elif is-linux && [[ -f "${DOTFILES_CONFIG_DIR}/zshrc.linux.sh" ]]; then
  source "${DOTFILES_CONFIG_DIR}/zshrc.linux.sh"
fi

eval "$(starship init zsh)"
